<mxCell id="site" value="&lt;b&gt;场址与候选配置 x&lt;/b&gt;&lt;br/&gt;配套用地、气象与可用资源&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;水电限具备开发条件的场址&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f3fa;strokeColor=#54809b;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="26" y="232" width="224" height="84" as="geometry"/></mxCell>
<mxCell id="thermal" value="&lt;b&gt;煤电或燃气　·　式（2）&lt;/b&gt;&lt;br/&gt;Pⱼ = Nⱼ × pⱼⁿᵉᵗ&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;机组台数 × 单机持续净功率&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#879aa5;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="300" y="91" width="354" height="76" as="geometry"/></mxCell>
<mxCell id="wind" value="&lt;b&gt;风电　·　式（3）&lt;/b&gt;&lt;br/&gt;X风 = A风 × ρ风；P风 = α风 × X风&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;合格面积 → 装机 → 可持续功率&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#879aa5;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="300" y="189" width="354" height="76" as="geometry"/></mxCell>
<mxCell id="hydro" value="&lt;b&gt;水电　·　式（4）&lt;/b&gt;&lt;br/&gt;P水 = min(X水, 0.00981 η Q H)&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;可用流量 Q 与净落差 H 决定水能&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#879aa5;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="300" y="287" width="354" height="76" as="geometry"/></mxCell>
<mxCell id="solar" value="&lt;b&gt;光伏与储能　·　式（5）&lt;/b&gt;&lt;br/&gt;X光 = A光 × ρ光；P光储 = f光储(…)&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;输入天气、电池功率与电量；见附录 A&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#879aa5;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="300" y="385" width="354" height="76" as="geometry"/></mxCell>
<mxCell id="self" value="&lt;b&gt;方案 x 的自发电可靠容量&lt;/b&gt;&lt;br/&gt;P自发电(x)  ·  MW&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;同一考察期内可持续补充的净功率&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f3eb;strokeColor=#478168;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="716" y="232" width="278" height="84" as="geometry"/></mxCell>
<mxCell id="grid" value="&lt;b&gt;固定公共电网&lt;/b&gt;&lt;br/&gt;P电网  ·  MW&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;接入点正常运行时可持续购电&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f3fa;strokeColor=#54809b;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="26" y="511" width="224" height="84" as="geometry"/></mxCell>
<mxCell id="sum" value="&lt;b&gt;园区可靠总功率　·　式（1）&lt;/b&gt;&lt;br/&gt;P总(x) = P电网 + P自发电(x)&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;两路功率须能同时送达&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3d9;strokeColor=#a98236;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="343" y="511" width="295" height="84" as="geometry"/></mxCell>
<mxCell id="it" value="&lt;b&gt;额定 IT 容量　·　式（6）&lt;/b&gt;&lt;br/&gt;P_E(x) = P总(x) / k(x)&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;k 为满载设施总功率与 IT 功率之比&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f3eb;strokeColor=#478168;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="716" y="511" width="278" height="84" as="geometry"/></mxCell>
<mxCell id="best" value="&lt;b&gt;电力分项上限&lt;/b&gt;&lt;br/&gt;P_E = maxₓ P_E(x)  ·  MW IT" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f3eb;strokeColor=#478168;fontColor=#1c3542;fontSize=15;fontFamily=Microsoft YaHei;spacing=5;"><mxGeometry x="716" y="632" width="278" height="56" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
